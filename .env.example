# Zebra configuration — copy to `.env` and adjust, or set in your shell.

# --- Model provider -----------------------------------------------------

# Model name to request from the provider.
ZEBRA_MODEL=gpt-5.4-mini

# Backend: "openai" (official API) or "compatible" (self-hosted OpenAI-compatible).
ZEBRA_MODEL_BACKEND=openai

# Only used when ZEBRA_MODEL_BACKEND=compatible:
# ZEBRA_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# ZEBRA_MODEL_API_KEY=zebra

# Only used when ZEBRA_MODEL_BACKEND=openai:
# OPENAI_API_KEY=sk-...

# --- Sandbox ------------------------------------------------------------

# "docker" (default, recommended) or "unix-local" (trusted dev only).
ZEBRA_SANDBOX_BACKEND=docker
ZEBRA_DOCKER_IMAGE=node:22-bookworm-slim

# --- Browser ------------------------------------------------------------

# "1" = headless (default), "0" = show the browser window.
ZEBRA_BROWSER_HEADLESS=1

# --- Safety & limits ----------------------------------------------------

# "1" = auto-approve browser click/type/keypress (dangerous; dev only).
ZEBRA_AUTO_APPROVE=0

# Max model turns per request.
ZEBRA_MAX_TURNS=12

# --- Gateway ------------------------------------------------------------

# HTTP + WebSocket listen port (gateway mode only).
ZEBRA_GATEWAY_PORT=3000
